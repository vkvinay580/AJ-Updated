APP_NAME="Aryan Gold Attendance"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://attendance.aryangold.in
APP_TIMEZONE=Asia/Kolkata

# Vault is loaded before Laravel reads this file. Credential-file presence enables
# it automatically; export VAULT_REQUIRED=true in the PHP runtime for fail-closed
# enforcement even if a credential file is accidentally removed.
VAULT_ENABLED=true
VAULT_REQUIRED=true
VAULT_ADDR=http://127.0.0.1:8200
VAULT_APPLICATION=attendance
VAULT_SECRET_PATH=secret/data/apps/attendance
VAULT_ROLE_ID_FILE=/home/admin1/.config/aryangold-vault/attendance/role-id
VAULT_SECRET_ID_FILE=/home/admin1/.config/aryangold-vault/attendance/secret-id
VAULT_TIMEOUT_SECONDS=5

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
DB_CONNECTION=mysql
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
MAIL_MAILER=smtp
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=hello@aryangold.in
MAIL_FROM_NAME="${APP_NAME}"

APP_UPDATE_ANDROID_PACKAGE_NAME=aryan.attendance
APP_UPDATE_ANDROID_LATEST_VERSION=5.0.42
APP_UPDATE_ANDROID_LATEST_BUILD=5043
APP_UPDATE_ANDROID_MIN_SUPPORTED_BUILD=5039
APP_UPDATE_ANDROID_FORCE=true
APP_UPDATE_ANDROID_DOWNLOAD_URL=https://aryangold.in/downloads/aryan-attendance.apk
APP_UPDATE_ANDROID_TITLE="Update required"
APP_UPDATE_ANDROID_MESSAGE="A newer version of Aryan Gold Attendance is available. Please update the app to continue."
APP_UPDATE_ANDROID_RELEASE_NOTES="Official Aryan Gold logo across the app, splash screen, ID cards, favicons, notifications, and launcher icons"
ARYANGOLD_EMPLOYEE_SYNC_URL=
ARYANGOLD_EMPLOYEE_SYNC_TIMEOUT=15
MOBILE_API_TOTP_ISSUER="Aryan Gold Emergency"
BIRTHDAY_SMS_ENDPOINT=
BIRTHDAY_SMS_SENDER_ID=
BIRTHDAY_SMS_TIMEOUT=15
FIREBASE_PROJECT_ID=aryan-80155

# secret/data/apps/attendance contains APP_KEY, database credentials, mail
# credentials, integration/sync tokens, mobile-control secrets, SMS/CARTO keys,
# VM_LOGIN_PASSWORD, and Firebase service-account material.
