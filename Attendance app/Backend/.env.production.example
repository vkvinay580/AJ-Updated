APP_NAME="Aryan Gold Attendance"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://attendance.aryangold.in
APP_TIMEZONE=Asia/Kolkata

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=replace-with-cpanel-database-name
DB_USERNAME=replace-with-cpanel-database-user
DB_PASSWORD=replace-with-cpanel-database-password

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

MAIL_MAILER=smtp
MAIL_HOST=replace-with-smtp-host
MAIL_PORT=587
MAIL_USERNAME=replace-with-smtp-user
MAIL_PASSWORD=replace-with-smtp-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=hello@aryangold.in
MAIL_FROM_NAME="${APP_NAME}"

APP_UPDATE_ANDROID_PACKAGE_NAME=aryan.attendance
APP_UPDATE_ANDROID_LATEST_VERSION=5.0.40
APP_UPDATE_ANDROID_LATEST_BUILD=5041
APP_UPDATE_ANDROID_MIN_SUPPORTED_BUILD=5039
APP_UPDATE_ANDROID_FORCE=true
APP_UPDATE_ANDROID_DOWNLOAD_URL=https://aryangold.in/downloads/aryan-attendance.apk
APP_UPDATE_ANDROID_TITLE="Update required"
APP_UPDATE_ANDROID_MESSAGE="A newer version of Aryan Gold Attendance is available. Please update the app to continue."
APP_UPDATE_ANDROID_RELEASE_NOTES="Smooth page, dialog, sheet, dashboard, and submission transitions; full-screen Aryan Gold splash"

# Use the same independently generated secret as ATTENDANCE_INTEGRATION_KEY in AJ.
ARYANGOLD_BUSINESS_INTEGRATION_KEY=replace-with-the-same-secret-used-by-aj

# The current AJ integration pulls from this API. Leave legacy outbound sync disabled.
ARYANGOLD_EMPLOYEE_SYNC_URL=
ARYANGOLD_EMPLOYEE_SYNC_TOKEN=
ARYANGOLD_EMPLOYEE_SYNC_TIMEOUT=15

MOBILE_API_CONTROL_PASSWORD_HASH=
MOBILE_API_TOTP_SECRET=
MOBILE_API_TOTP_ISSUER="Aryan Gold Emergency"

BIRTHDAY_SMS_ENDPOINT=
BIRTHDAY_SMS_TOKEN=
BIRTHDAY_SMS_SENDER_ID=
BIRTHDAY_SMS_TIMEOUT=15
CARTO_API_KEY=
