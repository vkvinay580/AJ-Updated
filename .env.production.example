NODE_ENV=production
HOSTNAME=0.0.0.0
PORT=3000
NEXT_PUBLIC_SITE_URL=https://aryangold.in
ATTENDANCE_API_URL=https://attendance.aryangold.in/api
BRANCH_PORTAL_URL=https://biz.aryangold.in
DB_CONNECTION_LIMIT=10
DB_SSL=false

# Secrets are read from HashiCorp Vault before Next.js starts.
VAULT_ENABLED=true
VAULT_REQUIRED=true
VAULT_ADDR=http://127.0.0.1:8200
VAULT_APPLICATION=business
VAULT_SECRET_PATH=secret/data/apps/business
VAULT_ROLE_ID_FILE=/home/admin1/.config/aryangold-vault/business/role-id
VAULT_SECRET_ID_FILE=/home/admin1/.config/aryangold-vault/business/secret-id
VAULT_TIMEOUT_MS=5000

# secret/data/apps/business contains DB_HOST, DB_PORT, DB_USER, DB_PASSWORD,
# DB_NAME, DATA_ENCRYPTION_KEY, initial/admin role credentials,
# ATTENDANCE_INTEGRATION_KEY, and optional Firebase server credentials.
