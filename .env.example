NODE_ENV=development
HOSTNAME=127.0.0.1
PORT=3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ATTENDANCE_API_URL=http://127.0.0.1:8000/api
BRANCH_PORTAL_URL=http://localhost:3000/branch
DB_CONNECTION_LIMIT=10
DB_SSL=false

# Recommended: use a local AppRole restricted to secret/data/apps/business.
VAULT_ENABLED=true
VAULT_ADDR=http://127.0.0.1:8200
VAULT_APPLICATION=business
VAULT_SECRET_PATH=secret/data/apps/business
# Defaults when omitted:
# VAULT_ROLE_ID_FILE=~/.config/aryangold-vault/business/role-id
# VAULT_SECRET_ID_FILE=~/.config/aryangold-vault/business/secret-id

# Tests may set VAULT_ENABLED=false and inject isolated throwaway values directly.
